    "version": "0.2.0",
    "configurations": [
        {
            "type": "pwa-chrome",
            "request": "launch",
            "name": "Open kaart.html",
            "url": "http://localhost:5500/kaart.html",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "Start Leaflet map server"
        },
        {
            "type": "pwa-chrome",
            "request": "launch",
            "name": "Open OpenLayers map",
            "url": "http://localhost:5500/openlayers-map.html",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "Start Leaflet map server"
        }
    ]
}