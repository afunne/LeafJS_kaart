{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Leaflet map server",
            "type": "process",
            "command": "py",
            "args": ["-m", "http.server", "5500"],
            "isBackground": true,
            "problemMatcher": {
                "owner": "leaflet-map-server",
                "pattern": {
                    "regexp": ".*",
                    "file": 1,
                    "line": 1,
                    "message": 2
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*Serving HTTP on.*",
                    "endsPattern": ".*"
                }
            },
            "presentation": {
                "reveal": "never",
                "panel": "dedicated"
            }
        }
    ]
}